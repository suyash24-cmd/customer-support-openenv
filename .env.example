# --- Gemini / Google GenAI SDK -----------------------------------------
# Get a key from https://aistudio.google.com/apikey (Gemini Developer API)
GOOGLE_API_KEY=

# --- Google Cloud (used for Vertex AI mode + Cloud Run + Firestore) ----
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Set to "true" to route Gemini calls through Vertex AI instead of the
# Gemini Developer API (requires GOOGLE_CLOUD_PROJECT + `gcloud auth`).
GOOGLE_GENAI_USE_VERTEXAI=false

# Model used by the ADK agent. Override to pin a specific Gemini release.
GEMINI_MODEL=gemini-3.5-flash

# --- Firestore ------------------------------------------------------------
# If unset, the app automatically falls back to an in-memory store so it
# runs locally with zero Google Cloud setup. Set to "true" once Firestore
# is provisioned (see README > Google Cloud Deployment).
USE_FIRESTORE=false
FIRESTORE_COLLECTION_PREFIX=customer_support

# --- Server -----------------------------------------------------------
# Cloud Run injects PORT automatically; default matches local dev.
PORT=8080
